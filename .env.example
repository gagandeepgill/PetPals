# PostgreSQL 16 + PostGIS. When unset, the app serves demo seed data so the UI
# runs without infrastructure.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/petpals

# RescueGroups API v5 key (https://rescuegroups.org). Required by `npm run ingest`.
RESCUEGROUPS_API_KEY=

# Shared secret for POST /api/revalidate (ingestion -> on-demand ISR).
REVALIDATE_SECRET=change-me
